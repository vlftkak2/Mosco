# Create a random value with at least 32 characters for each deployment.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# AI steel order recognition test (the API key remains on the FastAPI server)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_ORDER_MOCK_MODE=false
AI_ORDER_DAILY_LIMIT=10
AI_ORDER_COMPANY_DAILY_LIMIT=100
AI_ORDER_MONTHLY_BUDGET_USD=20
# 0 disables the per-company monthly cap; the global monthly budget still applies.
AI_ORDER_COMPANY_MONTHLY_BUDGET_USD=0
AI_ORDER_REQUEST_RESERVE_USD=0.50
AI_ORDER_MAX_FILE_SIZE_MB=10
AI_ORDER_MAX_PDF_PAGES=10
AI_ORDER_MAX_EXCEL_SHEETS=30
AI_ORDER_MAX_EXCEL_CELLS=20000
AI_ORDER_MAX_EXCEL_CHARACTERS=150000
AI_ORDER_MAX_OUTPUT_TOKENS=6000
AI_ORDER_REQUEST_TIMEOUT_SECONDS=90
AI_ORDER_MAX_CONCURRENT_REQUESTS_PER_WORKER=4
# Shared usage-store limits; current SQLite backend coordinates workers sharing one usage DB file.
AI_ORDER_MAX_CONCURRENT_PER_USER=2
AI_ORDER_MAX_CONCURRENT_PER_COMPANY=8
AI_ORDER_MAX_CONCURRENT_GLOBAL=20
AI_ORDER_MAX_QUEUE_WAIT_SECONDS=900
AI_ORDER_MENU_ID=AI-ORDER-TEST
AI_ORDER_REASONING_EFFORT=low
AI_ORDER_USAGE_DB_PATH=instance/ai_order_usage.sqlite3
# Current gpt-5.4-mini standard API token rates (USD per 1M); override if pricing changes.
AI_ORDER_INPUT_PRICE_PER_MILLION=0.75
AI_ORDER_CACHED_INPUT_PRICE_PER_MILLION=0.075
AI_ORDER_OUTPUT_PRICE_PER_MILLION=4.50
