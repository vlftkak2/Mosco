# Create a random value with at least 32 characters for each deployment.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# PostgreSQL connection. For a database installed on the Docker host, use host.docker.internal.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=Mosco
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password

# AI steel order recognition test (the API key remains on the FastAPI server)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_ORDER_DAILY_LIMIT=100
AI_ORDER_COMPANY_DAILY_LIMIT=100
AI_ORDER_MONTHLY_BUDGET_USD=20
# 0 disables the per-company monthly cap; the global monthly budget still applies.
AI_ORDER_COMPANY_MONTHLY_BUDGET_USD=0
AI_ORDER_REQUEST_RESERVE_USD=0.50
AI_ORDER_MAX_FILE_SIZE_MB=30
AI_ORDER_MAX_PDF_PAGES=10
AI_ORDER_MAX_IMAGE_PAGES=10
AI_ORDER_MAX_OUTPUT_TOKENS=6000
AI_ORDER_REQUEST_TIMEOUT_SECONDS=90
AI_ORDER_MAX_CONCURRENT_REQUESTS_PER_WORKER=4
# Shared usage-store limits; current SQLite backend coordinates workers sharing one usage DB file.
AI_ORDER_MAX_CONCURRENT_PER_USER=2
AI_ORDER_MAX_CONCURRENT_PER_COMPANY=8
AI_ORDER_MAX_CONCURRENT_GLOBAL=20
AI_ORDER_MAX_QUEUE_WAIT_SECONDS=900
AI_ORDER_MENU_ID=AI-ORDER-TEST
AI_ORDER_REASONING_EFFORT=low
AI_ORDER_USAGE_DB_PATH=instance/ai_order_usage.sqlite3
# Current gpt-5.4-mini standard API token rates (USD per 1M); override if pricing changes.
AI_ORDER_INPUT_PRICE_PER_MILLION=0.75
AI_ORDER_CACHED_INPUT_PRICE_PER_MILLION=0.075
AI_ORDER_OUTPUT_PRICE_PER_MILLION=4.50

# AI 업무비서 (챗봇 · 모스코 전용). OPENAI_API_KEY 만 위와 같이 쓰고 나머지는 AI_ORDER_* 와 따로 정한다.
# 비워 두거나 값이 잘못되면 아래 기본값으로 동작한다 (백엔드 기동은 막지 않고 로그에 경고만 남김).
AI_CHAT_MODEL=gpt-5.4-mini
AI_CHAT_REASONING_EFFORT=low
AI_CHAT_MAX_OUTPUT_TOKENS=4000
AI_CHAT_REQUEST_TIMEOUT_SECONDS=60
# 질문 1건에서 조회 도구를 부르는 최대 단계 수 (그다음 단계는 도구 없이 답만 쓴다)
AI_CHAT_MAX_TOOL_ROUNDS=4
AI_CHAT_USER_DAILY_LIMIT=200
AI_CHAT_COMPANY_DAILY_LIMIT=1000
# 챗봇 전체 월 예산 (USD). 주문서인식 예산(AI_ORDER_MONTHLY_BUDGET_USD)과 따로 센다.
AI_CHAT_MONTHLY_BUDGET_USD=10
# 질문 1건 처리 중 예산에서 미리 잡아 두는 금액의 최소값. 실제로는 (최대 단계 × 토큰 상한) 계산값과 큰 쪽(기본 약 0.24)을 잡는다.
AI_CHAT_REQUEST_RESERVE_USD=0.05
AI_CHAT_MAX_CONCURRENT_PER_USER=2
AI_CHAT_MAX_CONCURRENT_GLOBAL=10
AI_CHAT_INPUT_PRICE_PER_MILLION=0.75
AI_CHAT_CACHED_INPUT_PRICE_PER_MILLION=0.075
AI_CHAT_OUTPUT_PRICE_PER_MILLION=4.50

# DB 잠금 · 연결 (기본값이면 생략 가능, DOCKER.md "잠금 · 연결 관련 백엔드 설정" 참고)
# DB_LOCK_TIMEOUT_MS=10000
# DB_POOL_MAX=30
# DB_POOL_MAX_PER_COMPANY=10
# API_THREADPOOL_SIZE=100
# DB_REPORT_WORK_MEM=64MB
